# Copy to .env and fill in. Never commit .env (it holds your CARTO token).
# Region API base, e.g. https://gcp-us-east1.api.carto.com
VITE_CARTO_API_BASE=https://<region>.api.carto.com
VITE_CARTO_CONNECTION=carto_dw
# Public CARTO API access token, scoped to the tables below and referer-locked (see README).
VITE_CARTO_TOKEN=your_carto_public_token
# Fully-qualified table names in your warehouse
VITE_ROUTES_TABLE=project.dataset.nyc_bus_corridor_routes
VITE_LANES_TABLE=project.dataset.nyc_bus_corridor_lanes
VITE_MONTHLY_TABLE=project.dataset.nyc_bus_corridor_monthly
